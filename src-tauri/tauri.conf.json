{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskfisch",
  "version": "0.4.3",
  "identifier": "com.an.fisch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Deskfisch",
        "width": 1170,
        "height": 690,
        "minWidth": 400,
        "minHeight": 260,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEODVFODhDMUJCNDBEOTkKUldTWkRiUWJqT2lGUFkwNVhoUWY4cWFycWNQWVg2c2pleXFHTmhxc1VzWmVZdFFJOGo1dXdDMGMK",
      "endpoints": [
        "https://github.com/codepawl/deskfisch/releases/latest/download/latest.json"
      ]
    }
  }
}
